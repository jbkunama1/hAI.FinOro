# .env.example - eToro configuration
ETORO_API_KEY=your_api_key_here
ETORO_USER_KEY=your_user_key_here
ETORO_API_URL=https://public-api.etoro.com/api/v1
ETORO_BASE_URL=https://api.etoro.com
ETORO_SANDBOX=true
ETORO_EXECUTION_ENABLED=false
ETORO_KILL_SWITCH=true
ETORO_CONFIRMATION_PHRASE=CONFIRM
ETORO_MAX_TRADE_USD=500
ETORO_MAX_DAILY_TRADE_USD=1000
ETORO_MAX_OPEN_POSITIONS=25 # Max concurrent open positions
ETORO_MAX_TRADE_SIZE=25.0 # Max units per trade for an instrument
# ETORO_SYMBOL_ALLOWLIST=BTC,ETH,GOLD,OIL,EUR,GBP
ETORO_MAX_DAILY_LOSS=100
ETORO_MAX_DRAWDOWN_PCT=10
ETORO_RISK_PER_TRADE_PCT=5
ETORO_TRADE_START=08:00
ETORO_TRADE_END=22:00
LLM_URL=https://9router.arbeitermili.eu/v1
LLM_MODEL=finance
LLM_API_KEY=your_llm_api_key_here
APP_PORT=8080
LOG_LEVEL=INFO
